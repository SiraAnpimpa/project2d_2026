[node name="Header" type="HBoxContainer" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
layout_mode = 2

[node name="Title" type="Label" parent="SettingsOverlay/SettingsPanel/Margin/Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.827, 0.969, 1, 1)
theme_override_fonts/font = ExtResource("3_pixel_display")
theme_override_font_sizes/font_size = 22
text = "SETTINGS"
vertical_alignment = 1

[node name="CloseSettingsButton" type="Button" parent="SettingsOverlay/SettingsPanel/Margin/Content/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(42, 38)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "X"

[node name="Subtitle" type="Label" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.506, 0.722, 0.8, 1)
theme_override_fonts/font = ExtResource("4_readable")
theme_override_font_sizes/font_size = 11
text = "GAME SETTINGS // ปรับค่าได้ระหว่างเล่น"

[node name="Divider" type="ColorRect" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.176, 0.667, 0.86, 0.72)

[node name="MusicToggle" type="CheckButton" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_readable")
text = "เพลงประกอบ  //  MUSIC"

[node name="SfxToggle" type="CheckButton" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_readable")
text = "เสียงเอฟเฟกต์  //  SFX"

[node name="FullscreenToggle" type="CheckButton" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_readable")
text = "เต็มหน้าจอ  //  FULLSCREEN"

[node name="ProtocolInfo" type="Label" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.58, 0.722, 0.776, 1)
theme_override_fonts/font = ExtResource("4_readable")
theme_override_font_sizes/font_size = 11
text = "ONE-LIFE PROTOCOL\nเมื่อตาย Salvage จะตก ณ จุดเสียชีวิต\nและระบบจะพากลับไปยังจุดเริ่มต้น"
autowrap_mode = 2

[node name="SaveButton" type="Button" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_readable")
text = "บันทึกภารกิจ  //  SAVE PROGRESS"

[node name="SaveStatus" type="Label" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.506, 0.957, 0.635, 1)
theme_override_fonts/font = ExtResource("4_readable")
theme_override_font_sizes/font_size = 10
text = "การตั้งค่าจะบันทึกอัตโนมัติ"
horizontal_alignment = 1

[node name="ReturnDivider" type="ColorRect" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.176, 0.667, 0.86, 0.42)

[node name="MainMenuButton" type="Button" parent="SettingsOverlay/SettingsPanel/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
tooltip_text = "บันทึกความคืบหน้าและกลับสู่เมนูหลัก"
theme_override_colors/font_color = Color(0.976, 0.808, 0.384, 1)
theme_override_colors/font_hover_color = Color(1, 0.925, 0.682, 1)
theme_override_fonts/font = ExtResource("4_readable")
text = "กลับสู่เมนูหลัก  //  MAIN MENU"

[connection signal="pressed" from="GameUI/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="button_down" from="GameUI/DPad/Up" to="." method="_on_btn_up_pressed"]
[connection signal="button_up" from="GameUI/DPad/Up" to="." method="_on_btn_up_released"]
[connection signal="button_down" from="GameUI/DPad/Left" to="." method="_on_btn_left_pressed"]
[connection signal="button_up" from="GameUI/DPad/Left" to="." method="_on_btn_left_released"]
[connection signal="button_down" from="GameUI/DPad/Right" to="." method="_on_btn_right_pressed"]
[connection signal="button_up" from="GameUI/DPad/Right" to="." method="_on_btn_right_released"]
[connection signal="button_down" from="GameUI/DPad/Down" to="." method="_on_btn_down_pressed"]
[connection signal="button_up" from="GameUI/DPad/Down" to="." method="_on_btn_down_released"]
[connection signal="button_down" from="GameUI/InteractButton" to="." method="_on_btn_interact_button_down"]
[connection signal="button_up" from="GameUI/InteractButton" to="." method="_on_btn_interact_button_up"]
[connection signal="pressed" from="SettingsOverlay/SettingsPanel/Margin/Content/Header/CloseSettingsButton" to="." method="_on_close_settings_pressed"]
[connection signal="toggled" from="SettingsOverlay/SettingsPanel/Margin/Content/MusicToggle" to="." method="_on_music_toggled"]
[connection signal="toggled" from="SettingsOverlay/SettingsPanel/Margin/Content/SfxToggle" to="." method="_on_sfx_toggled"]
[connection signal="toggled" from="SettingsOverlay/SettingsPanel/Margin/Content/FullscreenToggle" to="." method="_on_fullscreen_toggled"]
[connection signal="pressed" from="SettingsOverlay/SettingsPanel/Margin/Content/SaveButton" to="." method="_on_save_pressed"]
[connection signal="pressed" from="SettingsOverlay/SettingsPanel/Margin/Content/MainMenuButton" to="." method="_on_main_menu_pressed"]
